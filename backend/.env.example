OPENAI_API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
VISION_MODEL_NAME=gpt-4o-mini

# LLM calls are disabled by default for deterministic local tests.
# Set ENABLE_LLM=true explicitly in development/production to use LLM features.
ENABLE_LLM=false
DRINKMIND_OFFLINE=false

# Optional: use an LLM to infer drink composition before deterministic
# ingredient rules calculate the final nutrition values.
ENABLE_LLM_COMPOSITION=false

# Comma-separated frontend origins allowed to call the API.
# Do not use "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional persistent storage overrides. Docker Compose sets these paths to
# its mounted /data volume automatically.
# DATABASE_URL=sqlite:////data/drinks.db
# CHROMA_PERSIST_DIR=/data/chroma_db

# Optional Dify-first chat and intake parsing. Failures fall back to the
# structured Intake Agent, then local field-extraction rules.
COMPANION_PROVIDER=local
DIFY_BASE_URL=http://localhost:8081/v1
DIFY_API_KEY=
DIFY_USER_ID=drinkmind-local-user
DIFY_TIMEOUT_SECONDS=60
