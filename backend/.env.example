OPENAI_API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
VISION_MODEL_NAME=gpt-4o-mini

# LLM calls are disabled by default for deterministic local tests.
# Set ENABLE_LLM=true explicitly in development/production to use LLM features.
ENABLE_LLM=false
DRINKMIND_OFFLINE=false

# Optional: only use LLM to infer drink composition when rule decomposition is
# low-confidence or the drink looks complex. Final nutrition values still come
# from deterministic ingredient rules.
ENABLE_LLM_COMPOSITION=false

# Comma-separated frontend origins allowed to call the API.
# Do not use "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Dify-backed companion chat. The existing local companion remains
# available and is used automatically when Dify is disabled or unavailable.
COMPANION_PROVIDER=local
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_USER_ID=drinkmind-local-user
DIFY_TIMEOUT_SECONDS=60
